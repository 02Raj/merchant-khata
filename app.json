{
  "expo": {
    "name": "OmniBill",
    "slug": "omnibill-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "omnibill",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D3D47"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.omnibill.pos",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "navigationBar": {
        "backgroundColor": "#ffffff",
        "barStyle": "dark-content"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1D3D47"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OmniBill to access your camera to scan bills."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
